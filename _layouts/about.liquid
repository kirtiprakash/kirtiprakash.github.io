---
layout: default
---

<div class="home-page">
  <section class="home-hero no-portrait" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="hero-eyebrow">{{ page.hero_eyebrow }}</p>
      <h1 id="hero-title">{{ site.first_name }} {{ site.last_name }}</h1>
      <p class="hero-role">{{ page.hero_role }}</p>
      <p class="hero-intro">{{ page.hero_intro }}</p>

      {% if page.hero_meta %}
        <div class="hero-meta" aria-label="Profile details">
          {% for item in page.hero_meta %}
            <span>{{ item }}</span>
          {% endfor %}
        </div>
      {% endif %}

      <div class="hero-actions">
        <a class="button button-primary" href="{{ '/projects/' | relative_url }}">Explore research <span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href="{{ '/publications/' | relative_url }}">Publications <span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href="{{ '/assets/pdf/kirti_prakash_cv.pdf' | relative_url }}">Download CV <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <article class="home-content">
    {{ content }}

    {% if page.social %}
      <section class="profile-section contact-section" aria-labelledby="contact-heading">
        <div class="section-header">
          <p class="section-kicker">Contact</p>
        </div>
        <p>
          I welcome conversations with students, researchers, prospective PhD students,
          and postdoctoral researchers interested in fellowship routes.
        </p>
        <div class="contact-icons">{% include social.liquid %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </section>
    {% endif %}
  </article>
</div>
