---
layout: default
---

<div class="duck-page">
  <header class="duck-header" aria-labelledby="site-title">
    <h1 id="site-title">{{ site.first_name }} {{ site.last_name }}</h1>
    <p class="duck-subtitle">{{ page.hero_role }}</p>

    <nav class="duck-nav" aria-label="Primary navigation">
      <a href="{{ '/' | relative_url }}">Home</a>
      <a href="{{ '/blog/' | relative_url }}">Blog</a>
      <a href="{{ '/projects/' | relative_url }}">Research</a>
      <a href="{{ '/publications/' | relative_url }}">Publications</a>
      <a href="{{ '/cv/' | relative_url }}">CV</a>
    </nav>
  </header>

  <hr class="duck-rule" />

  <main class="duck-main">
    {{ content }}

    {% if page.selected_papers %}
      <section class="duck-section" aria-labelledby="selected-publications">
        <h2 id="selected-publications">Selected publications</h2>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    {% if site.latest_posts.enabled %}
      <section class="duck-section" aria-labelledby="latest-posts">
        <h2 id="latest-posts">Latest posts</h2>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}

    {% if page.social %}
      <section class="duck-section duck-social" aria-labelledby="contact-heading">
        <h2 id="contact-heading">Contact</h2>
        <div class="contact-icons">{% include social.liquid %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </section>
    {% endif %}
  </main>

  <hr class="duck-rule" />

  <footer class="duck-footer">
    <p>
      Visitors:
      <img src="https://visitor-badge.laobi.icu/badge?page_id=kirtiprakash.kirtiprakash.github.io" alt="visitor counter" />
    </p>
    <p>© {{ 'now' | date: '%Y' }} {{ site.first_name }} {{ site.last_name }}</p>
  </footer>
</div>
