---
layout: default
---
{% if page._styles %}
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="home-page standard-page">
  <section class="home-hero no-portrait standard-hero" aria-labelledby="standard-page-title">
    <div class="hero-copy">
      <p class="hero-eyebrow">{{ page.hero_eyebrow | default: 'AI for Science & Society' }}</p>
      <h1 id="standard-page-title">{{ page.title | capitalize }}</h1>
      {% if page.description %}
        <p class="hero-intro">{{ page.description }}</p>
      {% endif %}
    </div>
  </section>

  <article class="home-content standard-content">
    <section class="profile-section">
      {{ content }}
    </section>
  </article>

  {% if page.related_publications %}
    <section class="profile-section publication-list-section" aria-labelledby="references-heading">
      <div class="section-header">
        <p class="section-kicker">References</p>
        <h2 id="references-heading">Related publications</h2>
      </div>
      <div class="publications">
        {% bibliography --cited_in_order %}
      </div>
    </section>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
