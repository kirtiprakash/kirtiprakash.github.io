---
layout: default
---

<style>
  .cv-page .cv-hero {
    margin-bottom: 1rem;
  }

  .cv-page .cv-section-card {
    position: relative;
    overflow: hidden;
    padding-top: clamp(1.35rem, 2.4vw, 2rem);
    padding-bottom: clamp(1.35rem, 2.4vw, 2rem);
  }

  .cv-page .cv-section-card::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--kp-accent), rgba(22, 124, 128, 0.12));
    content: "";
  }

  .cv-page .cv-section-card .section-header {
    margin-bottom: 0.9rem;
  }

  .cv-page .cv-section-card .section-kicker {
    display: none;
  }

  .cv-page .cv-section-card h2 {
    margin-bottom: 0.2rem;
    font-size: clamp(1.55rem, 2.6vw, 2.35rem);
    letter-spacing: -0.045em;
  }

  .cv-simple-list {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cv-simple-item {
    position: relative;
    display: grid;
    grid-template-columns: 8.3rem minmax(0, 1fr);
    gap: 1.15rem;
    align-items: start;
    padding: 0.95rem 1rem;
    border: 1px solid transparent;
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(255, 253, 248, 0.84), rgba(255, 253, 248, 0.5));
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .cv-simple-item::after {
    position: absolute;
    top: 1.32rem;
    left: 9.1rem;
    width: 0.55rem;
    height: 0.55rem;
    border: 2px solid var(--kp-surface);
    border-radius: 999px;
    background: var(--kp-accent);
    box-shadow: 0 0 0 4px rgba(22, 124, 128, 0.11);
    content: "";
  }

  .cv-simple-item:hover {
    transform: translateY(-2px);
    border-color: rgba(22, 124, 128, 0.25);
    background: var(--kp-surface);
    box-shadow: 0 14px 34px rgba(18, 38, 58, 0.08);
  }

  html[data-theme="dark"] .cv-simple-item {
    background: linear-gradient(135deg, rgba(15, 36, 52, 0.84), rgba(15, 36, 52, 0.5));
  }

  html[data-theme="dark"] .cv-simple-item:hover {
    background: var(--kp-surface);
  }

  .cv-simple-date {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 0.72rem;
    border: 1px solid rgba(22, 124, 128, 0.18);
    border-radius: 999px;
    background: var(--kp-accent-soft);
    color: var(--kp-accent-dark);
    font-size: 0.86rem;
    font-weight: 760;
    line-height: 1.2;
    white-space: nowrap;
  }

  .cv-simple-main {
    padding-left: 0.25rem;
  }

  .cv-simple-title {
    margin: 0;
    color: var(--kp-ink);
    font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: clamp(0.98rem, 1.4vw, 1.08rem);
    font-weight: 700;
    letter-spacing: -0.016em;
    line-height: 1.42;
  }

  .cv-simple-role {
    color: var(--kp-ink);
    font-weight: 780;
  }

  .cv-simple-place-inline {
    color: var(--kp-muted);
    font-weight: 610;
  }

  .cv-simple-details {
    margin: 0.55rem 0 0;
    padding-left: 1.05rem;
    color: var(--kp-muted);
    font-size: 0.95rem;
    line-height: 1.58;
  }

  .cv-simple-details li {
    margin-bottom: 0.24rem;
  }

  .cv-simple-details li::marker,
  .cv-award-list li::marker {
    color: var(--kp-accent);
  }

  .cv-award-list {
    margin-top: 0;
    padding-left: 0;
    list-style: none;
  }

  .cv-award-list li {
    display: inline-flex;
    margin: 0.2rem 0.4rem 0.2rem 0;
    padding: 0.36rem 0.7rem;
    border: 1px solid rgba(22, 124, 128, 0.18);
    border-radius: 999px;
    background: rgba(22, 124, 128, 0.07);
    color: var(--kp-muted);
    font-weight: 650;
  }

  .cv-simple-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.65rem;
  }

  .cv-simple-links .button {
    min-height: 34px;
    padding: 0.35rem 0.7rem;
    font-size: 0.82rem;
  }

  @media (max-width: 820px) {
    .cv-simple-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      padding: 0.95rem;
    }

    .cv-simple-item::after {
      display: none;
    }

    .cv-simple-main {
      padding-left: 0;
    }

    .cv-simple-date {
      font-size: 0.82rem;
    }
  }
</style>

<div class="home-page cv-page">
  <section class="home-hero no-portrait cv-hero" aria-labelledby="cv-title">
    <div class="hero-copy">
      <p class="hero-eyebrow">Academic CV</p>
      <h1 id="cv-title">Curriculum Vitae</h1>
    </div>
  </section>

  <article class="home-content cv-content">
    <div class="cv">
      {% for entry in site.data.cv %}
        <a class="anchor" id="{{ entry.title | slugify }}"></a>
        <section class="profile-section cv-section-card" aria-labelledby="{{ entry.title | slugify }}-heading">
          <div class="section-header section-row">
            <div>
              <p class="section-kicker">CV section</p>
              <h2 id="{{ entry.title | slugify }}-heading">{{ entry.title }}</h2>
            </div>
          </div>
          <div class="cv-entry-body">
            {% if entry.type == 'list' %}
              {% include cv/list.liquid %}
            {% elsif entry.type == 'map' %}
              {% include cv/map.liquid %}
            {% elsif entry.type == 'nested_list' %}
              {% include cv/nested_list.liquid %}
            {% elsif entry.type == 'time_table' %}
              {% include cv/time_table.liquid %}
            {% elsif entry.type == 'list_groups' %}
              {% include cv/list_groups.liquid %}
            {% else %}
              {{ entry.contents }}
            {% endif %}
          </div>
        </section>
      {% endfor %}
    </div>
  </article>
</div>
